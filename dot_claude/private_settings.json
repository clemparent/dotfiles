{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "pyright-lsp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "cc-skills-golang@samber": false,
    "gopls-lsp@claude-plugins-official": true,
    "python-development@claude-code-workflows": true,
    "frontend-design@claude-plugins-official": true,
    "runcomfy@runcomfy": true,
    "reactive-resume@reactive-resume": true,
    "job-apply@neonwatty-plugins": true,
    "diagram-design@diagram-design": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      }
    },
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    },
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "runcomfy": {
      "source": {
        "source": "github",
        "repo": "runcomfy-com/skills"
      }
    },
    "reactive-resume": {
      "source": {
        "source": "github",
        "repo": "reactive-resume/reactive-resume"
      }
    },
    "neonwatty-plugins": {
      "source": {
        "source": "github",
        "repo": "neonwatty/job-apply-plugin"
      }
    },
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
