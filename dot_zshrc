# PATH stuff
export GOPATH=$HOME/go
export GOPRIVATE=github.com/urbn
local brew_path="/opt/homebrew/bin:/opt/homebrew/sbin"
local brew_ruby_path="/opt/homebrew/opt/ruby/bin"
local user_bins="$HOME/bin:$HOME/.local/bin:/usr/local/bin"
local go_bins="$GOPATH/bin"
# Drop duplicate PATH entries (nested shells in zellij re-run this file)
typeset -U path PATH
export PATH="$brew_ruby_path:$brew_path:$user_bins:$PATH:$go_bins"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme for ZSH
ZSH_THEME="mortalscumbag"

# ZSH Optimizations
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_AUTO_UPDATE="true"
DISABLE_COMPFIX="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"


# ZSH Plugins. Use the ZSH NVM plugin over the default NVM because
# It was making shell startup take a long time
zstyle ':omz:plugins:nvm' lazy yes
plugins=(
fzf-tab
gcloud
nvm
zsh-syntax-highlighting
)

# omz
source $ZSH/oh-my-zsh.sh

# Use helix as the default editor
export VISUAL=hx
export EDITOR="$VISUAL"


# Starship
eval "$(starship init zsh)"

# Yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}


# Misc. vars
export DOCKER_HOST="unix://$HOME/.colima/docker.sock"
export GITHUB_SSH_KEY=$(cat ~/.ssh/id_ed25519)

alias cdobs='cd /Users/cparent/Library/Mobile\ Documents/com~apple~CloudDocs/Obsidian/Obsidian\ Vault'

# Start zellij. Keep this block last: the Claude Code `return` skips everything below it.
if [[ -z "$ZELLIJ" ]] && [[ -z "$SSH_CONNECTION" ]] && [[ "$TERM_PROGRAM" != "vscode" ]]; then
  if [[ -n "$CLAUDECODE" ]]; then
    return  # Claude Code, no zellij
  fi

  if [[ "$TERM_PROGRAM" == "ghostty" ]]; then
    if [[ -z "$AGENT_TERM" ]]; then
      eval "$(zellij setup --generate-auto-start zsh)"
    else
      zellij attach -c main
    fi
  else
    zellij attach -c "scratch-$$"
  fi
fi
